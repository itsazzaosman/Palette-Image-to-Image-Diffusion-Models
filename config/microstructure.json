{
    "name": "microstructure_restoration",
    "phase": "train",
    "gpu_ids": [0],
    "path": {
        "log": "logs",
        "tb_logger": "tb_logger",
        "results": "results",
        "checkpoint": "checkpoint",
        "resume_state": null
    },
    "datasets": {
        "train": {
            "name": "Microstructure_Train",
            "mode": "paired",
            "dataroot_X": "/content/drive/MyDrive/ degraded_split/train", 
            "dataroot_Y": "/content/drive/MyDrive/dataset_split/train",
            "l_resolution": 128,
            "r_resolution": 128,
            "batch_size": 32,
            "num_workers": 4,
            "use_shuffle": true
        },
        "val": {
            "name": "Microstructure_Val",
            "mode": "paired",
            "dataroot_X": "/content/drive/MyDrive/ degraded_split/val",
            "dataroot_Y": "/content/drive/MyDrive/dataset_split/val",
            "l_resolution": 128,
            "r_resolution": 128
        }
    },
    "model": {
        "which_model_unet": "ddpm",
        "finetune_norm": false,
        "unet": {
            "in_channel": 2,
            "out_channel": 1,
            "inner_channel": 64,
            "channel_multiplier": [1, 2, 4, 8],
            "attn_res": [16],
            "res_blocks": 2,
            "dropout": 0.2
        },
        "beta_schedule": {
            "train": {
                "schedule": "linear",
                "n_timestep": 2000,
                "linear_start": 1e-6,
                "linear_end": 1e-2
            }
        },
        "diffusion": {
            "image_size": 128,
            "channels": 1,
            "conditional": true
        }
    },
    "train": {
        "n_iter": 100000,
        "val_freq": 2000,
        "save_checkpoint_freq": 5000,
        "print_freq": 100,
        "optimizer": {
            "type": "adam",
            "lr": 1e-5
        }
    }
}